DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Preserve Authorization header for PHP-FPM / FastCGI on Plesk Apache
  RewriteCond %{HTTP:Authorization} ^(.*)
  RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

  # Security Headers
  <IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
  </IfModule>

  # SPA Routing: Route non-existing paths to index.html, keeping /api/ handled by PHP
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteRule ^ index.html [L]
</IfModule>

# Bảo vệ tuyệt đối tệp cấu hình, cơ sở dữ liệu và file nhạy cảm
<FilesMatch "(\.env|\.sql|\.sqlite|\.sqlite-wal|\.sqlite-shm|\.db|\.jsonl|_store\.json|config\.php|config\.sample\.php)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Nén Gzip cho SPA & API JSON
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache 1 năm cho file Vite có hash (/assets/*), không cache index.html để luôn nhận bản deploy mới
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|svg|png|jpg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|build-info\.txt)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
